# Dependency folders (Folder modul pihak ketiga)
node_modules/
jspm_packages/
web_stage/

# Environment variables (Sangat penting agar data rahasia tidak bocor)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Logs (File catatan log sistem/error)
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Diagnostic reports (Laporan error Node.js)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data (Data sementara saat server berjalan)
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Build outputs (Jika Anda menggunakan TypeScript atau bundler seperti Babel)
dist/
build/
.out/

# IDE / Editor configuration (File konfigurasi bawaan aplikasi coding Anda)
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db


